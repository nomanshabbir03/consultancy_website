{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/app.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/about-us",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/bpo",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/inbound-call",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/outbound-call",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/email-and-chat",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/sms-support",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/health-care",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/medical-billing",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/medical-transcription",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/management-services",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/digital-marketing",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/web-development",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/graphic-designing",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/ui-ux-designing",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/search-engine-optimization",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/social-media-marketing",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/content-writing",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/blog",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/career",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/contact-us",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/blog/:slug",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/career/:slug",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)[.](js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
