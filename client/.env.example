# Client variables are PUBLIC (they are bundled into the browser build). Never put a secret here.
# Leave unset on Vercel: the app calls the API on the same domain (/api).
# For local dev the app defaults to http://localhost:5000/api.
VITE_API_URL=
# Optional: public site URL used for canonical / Open Graph URLs (defaults to the origin the page is served from).
VITE_SITE_URL=
