PORT=5000
NODE_ENV=development
# Browser origin(s) allowed by CORS (comma separated). Defaults to http://localhost:5173 in development, none in production.
CLIENT_ORIGIN=http://localhost:5173
SITE_URL=
# Supabase credentials are NOT set here: put SUPABASE_URL and SUPABASE_SECRET_KEY in the
# git-ignored .env.local at the project root (see ../.env.example).
