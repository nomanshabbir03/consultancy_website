# Copy to .env.local (git-ignored) for local development. On Vercel set these in Project Settings -> Environment Variables.
# Never commit real values. Server-only secrets must NEVER be prefixed with VITE_.

# --- Server (Express / Vercel function) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Public site URL, no trailing slash (used by sitemap.xml, robots.txt and canonical/OG tags), e.g. https://your-domain.com
SITE_URL=
# Only needed when the browser app is served from a DIFFERENT origin than the API (comma separated). Leave empty on Vercel.
CLIENT_ORIGIN=

# --- Form notifications (contact, inquiry and job-application emails go to MAIL_TO) ---
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<the Gmail address>, SMTP_PASS=<a Google "App password">
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to cmsolutions180@gmail.com when empty
MAIL_TO=
MAIL_FROM=

# --- Admin panel ---
# Public (publishable) key: used by the server only, to verify admin e-mail/password logins through Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=
